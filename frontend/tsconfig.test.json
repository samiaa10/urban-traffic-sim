{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": [
    "tests",
    "src/optimiser.ts",
    "src/OptimiserResults.tsx",
    "src/simulationHelpers.ts"
  ]
}
